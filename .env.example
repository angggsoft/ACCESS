# Terminal Hikvision ISAPI (Red Local LAN)
HIK_HOST=192.168.11.195
HIK_PORT=80
HIK_USER=admin
HIK_PASS=TU_PASSWORD_AQUI

# Credenciales de Red Wi-Fi para Terminal
WIFI_SSID=TU_RED_WIFI
